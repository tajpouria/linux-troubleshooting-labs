# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Linux Troubleshooting Labs: Level 1 (lab-01), "The storefront is down"
#
#   vagrant up                      # build web-01 and start the incident (~5 min)
#   vagrant snapshot save broken    # your reset point: take it right away
#   vagrant ssh                     # go fix it, then check with: sudo lab-check
#
# Host:  Apple Silicon Mac + VMware Fusion + vagrant-vmware-desktop plugin
# Guest: Ubuntu 24.04 LTS, ARM64 (bento/ubuntu-24.04)

Vagrant.require_version ">= 2.4.0" # config.vm.box_architecture needs 2.4+

LAB = {
  id:         "lab-01",
  title:      "The storefront is down",
  hostname:   "web-01",
  host_octet: 11,   # convention: lab-NN uses host .(10 + NN) on Fusion's host-only network
  cpus:       2,
  memory:     2048, # MB
}.freeze

COMMON = File.expand_path("../common", __dir__)

# Since macOS Big Sur, Fusion can't create host-only networks with custom
# subnets: Vagrant fails with "Failed to enable device". So instead of a made-up
# subnet such as 192.168.56.0/24, reuse the host-only network Fusion already
# has (normally vmnet1) and take a fixed address on it. The subnet is chosen
# randomly when Fusion is installed, so it differs from Mac to Mac.
def fusion_hostonly_ip(host_octet)
  path = "/Library/Preferences/VMware Fusion/networking"
  return nil unless File.readable?(path)

  vnets = Hash.new { |h, k| h[k] = {} }
  File.foreach(path) do |line|
    next unless (m = line.match(/^answer VNET_(\d+)_(\S+)\s+(\S+)/))
    vnets[m[1]][m[2]] = m[3]
  end
  # Fusion's own host-only networks have DHCP and no NAT. (Networks that
  # Vagrant tried and failed to create have no DHCP, so they're skipped.)
  usable = vnets.select do |_, v|
    v["HOSTONLY_SUBNET"] && v["HOSTONLY_NETMASK"] == "255.255.255.0" &&
      v["DHCP"] == "yes" && v["NAT"] != "yes"
  end
  _, vnet = usable.min_by { |num, _| num == "1" ? 0 : num.to_i }
  return nil unless vnet

  vnet["HOSTONLY_SUBNET"].split(".")[0, 3].push(host_octet).join(".")
end

LAB_IP = fusion_hostonly_ip(LAB[:host_octet])

# Extra disks. Vagrant's experimental `config.vm.disk` crashes with the bento
# box on Fusion (vagrant-vmware-desktop 3.0.5), so the disk is managed here:
# created with Fusion's vmware-vdiskmanager before `vagrant up`, attached on the
# box's existing SATA controller (slot 0 = system disk, slot 1 = CD-ROM), and
# deleted after `vagrant destroy`.
VDISKMANAGER = "/Applications/VMware Fusion.app/Contents/Library/vmware-vdiskmanager"
EXTRA_DISKS = [
  { slot: "sata0:2", size: "1GB", file: File.join(__dir__, ".vagrant", "#{LAB[:id]}-logs.vmdk") },
].freeze

# The disk entries go into the VM's .vmx only when the VM is first created.
# After a snapshot, VMware points them at delta files. Re-applying them on every
# boot would make the VM write to the snapshot's frozen base disk and break
# `vagrant snapshot restore`.
def vm_created?
  id_file = File.join(__dir__, ".vagrant", "machines", "default", "vmware_desktop", "id")
  File.exist?(id_file) && File.exist?(File.read(id_file).strip)
end

Vagrant.configure("2") do |config|
  config.vm.box              = "bento/ubuntu-24.04"
  config.vm.box_architecture = "arm64" # never fall back to an x86 image
  config.vm.hostname         = LAB[:hostname]
  config.vm.boot_timeout     = 600

  # A fixed address on Fusion's host-only network, reachable from your Mac.
  # If that network can't be found, fall back to DHCP; the address is then
  # shown by: vagrant ssh -c 'cat /etc/lab/lab.env'
  if LAB_IP
    config.vm.network "private_network", ip: LAB_IP
  else
    config.vm.network "private_network", type: "dhcp"
  end
  config.vm.post_up_message = <<~MSG
    #{LAB[:id]} (#{LAB[:hostname]}) is up.
      Storefront:  #{LAB_IP ? "http://#{LAB_IP}/" : "run: vagrant ssh -c 'cat /etc/lab/lab.env'"}
      Next:        vagrant snapshot save broken   (first time only), then vagrant ssh
  MSG

  # Fallback if the private network doesn't work on your Mac: uncomment this
  # line to reach the site at http://localhost:8001/ instead. VMware listens
  # on all host interfaces for forwarded ports.
  # config.vm.network "forwarded_port", guest: 80, host: 8001, auto_correct: true

  # Don't share this repo into the VM, because it contains the hints and solutions.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Extra 1 GB disk for the app's log volume (/var/log/bookshop). See EXTRA_DISKS.
  config.trigger.before :up do |t|
    t.name = "Create extra disks"
    t.ruby do |_env, _machine|
      EXTRA_DISKS.each do |d|
        next if File.exist?(d[:file])
        FileUtils.mkdir_p(File.dirname(d[:file]))
        ok = system(VDISKMANAGER, "-c", "-s", d[:size], "-a", "lsilogic", "-t", "0", d[:file],
                    out: File::NULL)
        raise "Could not create #{d[:file]} with #{VDISKMANAGER}" unless ok
      end
    end
  end
  config.trigger.after :destroy do |t|
    t.name = "Delete extra disks"
    t.ruby do |_env, _machine|
      EXTRA_DISKS.each { |d| FileUtils.rm_f(d[:file]) }
    end
  end

  config.vm.provider "vmware_desktop" do |vmware|
    vmware.cpus   = LAB[:cpus]
    vmware.memory = LAB[:memory]
    vmware.gui    = false # true opens the VM console in Fusion (useful if boot hangs)
    unless vm_created?
      EXTRA_DISKS.each do |d|
        vmware.vmx["#{d[:slot]}.present"]  = "TRUE"
        vmware.vmx["#{d[:slot]}.filename"] = d[:file]
      end
    end
  end

  # --- Provisioning: helpers -> common base -> healthy setup -> break ---------
  # Run once, on the first `vagrant up`. To reset the lab, restore the snapshot
  # or destroy and re-create the VM. Don't run `vagrant provision`.
  config.vm.provision "upload-lib", type: "file",
    source: "#{COMMON}/lib/lab-common.sh", destination: "/tmp/lab-common.sh"
  config.vm.provision "upload-check", type: "file",
    source: "check.sh", destination: "/tmp/lab-check"
  config.vm.provision "upload-ticket", type: "file",
    source: "TICKET.md", destination: "/tmp/lab-ticket.md"

  config.vm.provision "base", type: "shell", path: "#{COMMON}/provision/base.sh",
    env: { "LAB_ID" => LAB[:id], "LAB_TITLE" => LAB[:title], "LAB_IP" => LAB_IP || "auto" }
  config.vm.provision "setup", type: "shell", path: "provision/setup.sh"
  config.vm.provision "break", type: "shell", path: "provision/break.sh"
end
